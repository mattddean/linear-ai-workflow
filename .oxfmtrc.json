{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/expo/src/global.css",
    "functions": ["clsx", "cn", "cva"],
    "preserveWhitespace": true
  },
  "jsdoc": {},
  "ignorePatterns": [
    ".agents",
    ".claude",
    ".codex",
    "apps/expo/src/uniwind-types.d.ts",
    "apps/express/drizzle",
    "packages/shared/src/zero-schema.gen.ts",
    "bun.lock",
    "turbo/generators/templates"
  ]
}

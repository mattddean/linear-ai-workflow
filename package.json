{
  "name": "linear-ai-workflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "tooling/*"
    ]
  },
  "type": "module",
  "scripts": {
    "cli": "bun src/commands.ts",
    "db:down": "docker compose --env-file .env -f ./docker/compose.yaml down",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:remove": "docker compose --env-file .env -f ./docker/compose.yaml down --volumes",
    "db:up": "docker compose --env-file .env -f ./docker/compose.yaml up",
    "dev": "turbo run dev:coordinator dev:worker",
    "dev:coordinator": "bun src/index.ts",
    "dev:worker": "bun src/workflow-worker.ts",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ws": "bunx sherif@latest",
    "postinstall": "bun run lint:ws",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "whey": "bun whey/whey.mjs"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.116",
    "@effect/sql-pg": "4.0.0-rc.116",
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.0-rc.116",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.7.2",
    "@types/bun": "latest",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "2.9.14",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.3.14"
}

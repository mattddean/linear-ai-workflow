DATABASE_URL=postgres://linear:linear@127.0.0.1:3062/linear_ai_workflow
LINEAR_API_KEY=
LINEAR_TEAM_ID=
REPOSITORY_PATH=
BASE_BRANCH=main
WORKFLOW_SHARD_GROUP=local
# Optional: defaults to this machine's hostname. Keep it stable across restarts.
# WORKER_ID=my-mac
# Absolute local paths are required when configured.
# ISOLATE_ROOT=/absolute/path/to/isolates
# ARTIFACT_ROOT=/absolute/path/to/artifacts
POLL_SECONDS=30
# Shared limits for a complete PM → Developer → QA → PM run, including rework.
# Used by all runs without an explicit override. Restart coordinator and worker after changes.
RUN_MAX_ATTEMPTS=6
RUN_MAX_TOKENS=5000000
RUN_MAX_MINUTES=480
# For additional machines, use reachable private-network addresses and unique ports.
WORKFLOW_RUNNER_HOST=127.0.0.1
WORKFLOW_RUNNER_PORT=34541
